  "entity_hub": {
    "global_key": "ENT-RUT-{RUT_NORMALIZADO}",
    "valid_rut_required": true,
    "unresolved_policy": "ENTITY_ID_NULL_CANDIDATE_ONLY",
    "role_is_identity_independent": true,
    "current_status": "ADAPTER_READY",
    "local_ids_preserved": true,
    "adapter_module": "src/radar_sanciones/interop.py",
    "materialized_path": "docs/data/entity_hub_v1.json",
    "catalog_path": "docs/data/interop_catalog_v1.json"
  },
  "territory": {
    "region_key": "CL-REG-{CODIGO_REGION}",
    "commune_key": "CL-COM-{CODIGO_COMUNA}",
    "name_is_not_key": true,
    "current_status": "NOT_PRIMARY_DIMENSION"
  },
  "sector": {
    "mapping_statuses": ["VALIDATED_EXACT","VALIDATED_RULE","EMPIRICAL_CANDIDATE","AMBIGUOUS","NO_EQUIVALENCE"],
    "current_status": "REFERENCE_VIA_ENTITY_ENRICHMENT",
    "strong_membership_allowed": ["VALIDATED_EXACT","VALIDATED_RULE"]
  },
  "temporal_evidence": {
    "time_fields": ["observed_from","observed_to","source_published_at","retrieved_at","last_seen_at","last_successful_refresh_at"],
    "evidence_fields": ["evidence_id","source_id","source_url","ultimate_source_id","source_tier","capture_method","source_run_id","content_sha256","quality_status","schema_version"],
    "freshness_states": ["CURRENT","DUE","STALE","UNKNOWN"],
    "source_failure_is_zero": false,
    "preserve_last_known_good": true,
    "current_status": "ADAPTER_PARTIAL"
  },
  "scores": {
    "common_risk_score": false,
    "policy": "RADAR_SPECIFIC_ONLY",
    "required_metadata": ["score_name","score_value","score_version","score_scope"]
  },
  "exports": [
    {"path":"docs/data/entity_hub_v1.json","purpose":"canonical entity interoperability view"},
    {"path":"docs/data/interop_status_v1.json","purpose":"entity interoperability status"},
    {"path":"docs/data/interop_catalog_v1.json","purpose":"machine-readable interoperability catalog"},
    {"path":"docs/data/","purpose":"consumer-facing outputs and source health"}
  ],
  "consumer_contract": {
    "manifest_path": "interop/integration_manifest_v1.json",
    "schema_path": "interop/interop_contract_v1.schema.json"
  }
